{
  "name": "africa-saas-kit",
  "version": "0.8.16",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-check.mjs",
    "security:audit": "bash scripts/security-audit.sh .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "auth generate --config ./lib/auth/index.ts --output db/schema/auth.generated.ts -y",
    "payments:routes": "node scripts/seed-payment-routes.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/validate-config.mjs",
    "design:check": "node scripts/design-check.mjs",
    "design:plan": "node scripts/generate-implementation-plan.mjs",
    "doctor:production": "node scripts/production-doctor.mjs",
    "doctor:production:online": "node scripts/production-doctor.mjs --online",
    "doctor:json": "node scripts/production-doctor.mjs --json",
    "verify:code": "npm run security:check && npm run env:check && npm run runtime:check && npm run mobile:check && npm run ui:loading-check && npm run seo:check && npm run deploy:check && npm run features:check && npm run lint && npm run typecheck && npm run test",
    "verify:production": "npm run setup:check && npm run security:check && npm run env:check && npm run runtime:check && npm run mobile:check && npm run ui:loading-check && npm run seo:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:prod && npm run security:audit && npm run doctor:production && npm run features:check && npm run conformity:check",
    "payments:ngrok": "ngrok http 3000",
    "payments:local": "node scripts/local-payment-lab.mjs",
    "payments:local:apply": "node scripts/local-payment-lab.mjs --write-env",
    "mobile:check": "node scripts/mobile-first-check.mjs",
    "ui:loading-check": "node scripts/loading-check.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "deploy:handoff": "node scripts/deployment-handoff.mjs",
    "deploy:check": "node scripts/deployment-check.mjs",
    "auth:create-admin": "auth create-admin --config ./lib/auth/index.ts",
    "setup-saas": "node scripts/setup-saas.mjs",
    "setup-saas:mark": "node scripts/setup-saas-mark.mjs",
    "payments:setup": "node scripts/setup-payments.mjs",
    "cloudflare:setup": "node scripts/setup-cloudflare.mjs",
    "cloudinary:setup": "node scripts/setup-cloudinary.mjs",
    "conformity:check": "node scripts/conformity-check.mjs",
    "provider": "node scripts/provider.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "node scripts/format-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "ci:check": "npm run format:check && npm run env:check && npm run runtime:check && npm run features:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:prod",
    "format:prettier": "prettier --check .",
    "routes:list": "node scripts/route-inventory.mjs",
    "runtime:check": "node scripts/runtime-check.mjs",
    "features:list": "node scripts/feature-inventory.mjs --list",
    "features:check": "node scripts/feature-inventory.mjs",
    "smoke:system": "node scripts/smoke-system.mjs",
    "cron:generate": "node scripts/generate-vercel-cron.mjs",
    "env:check": "node scripts/env-contract-check.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "fedapay": "1.2.5",
    "libphonenumber-js": "1.13.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "auth": "1.7.3",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "vitest": "5.0.0"
  }
}
